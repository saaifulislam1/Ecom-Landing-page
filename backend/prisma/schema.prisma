generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  STORE_OWNER
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StaffRole {
  OWNER
  MANAGER
  DIGITAL_MARKETER
  MARKETING_OFFICER
  ORDER_MANAGER
  PRODUCT_MANAGER
  SUPPORT_AGENT
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryMethod {
  INSIDE_CITY
  OUTSIDE_CITY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ThemeLayoutStyle {
  CLASSIC_ECOMMERCE
  MODERN_GRID
  BOUTIQUE
  SINGLE_PRODUCT
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum GenericStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  phone        String?
  avatar       String?
  role         UserRole      @default(STORE_OWNER)
  status       UserStatus    @default(ACTIVE)
  stores       Store[]       @relation("StoreOwner")
  staffMembers StaffMember[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Store {
  id                String             @id @default(cuid())
  ownerId           String
  owner             User               @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  slug              String             @unique
  description       String?
  logo              String?
  email             String?
  phone             String?
  address           String?
  currency          String             @default("BDT")
  status            StoreStatus        @default(ACTIVE)
  subdomain         String?
  customDomain      String?
  products          Product[]
  categories        Category[]
  orders            Order[]
  customers         Customer[]
  coupons           Coupon[]
  carts             Cart[]
  campaignLinks     CampaignLink[]
  themeSettings     ThemeSettings?
  marketingSettings MarketingSettings?
  storeSettings     StoreSettings?
  homepageSettings  HomepageSettings?
  staffMembers      StaffMember[]
  subscription      StoreSubscription?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model StaffMember {
  id          String      @id @default(cuid())
  storeId     String
  userId      String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        StaffRole
  permissions Json?
  status      StaffStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([storeId, userId])
}

model Category {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]
  name        String
  slug        String
  description String?
  image       String?
  status      GenericStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([storeId, slug])
}

model Product {
  id               String        @id @default(cuid())
  storeId          String
  categoryId       String?
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  cartItems        CartItem[]
  title            String
  slug             String
  description      String
  shortDescription String?
  price            Decimal       @db.Decimal(12, 2)
  salePrice        Decimal?      @db.Decimal(12, 2)
  sku              String?
  stock            Int           @default(0)
  images           String[]
  badge            String?
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  bestSeller       Boolean       @default(false)
  variants         Json?
  seoTitle         String?
  seoDescription   String?
  ogImage          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([storeId, slug])
}

model Customer {
  id                 String                      @id @default(cuid())
  storeId            String
  store              Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders             Order[]
  carts              Cart[]
  emailVerificationTokens CustomerEmailVerificationToken[]
  name               String
  phone              String
  email              String?
  password           String?
  emailVerifiedAt    DateTime?
  address            String?
  city               String?
  totalOrders        Int                         @default(0)
  totalSpent         Decimal                     @default(0) @db.Decimal(12, 2)
  tags               String[]
  notes              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([storeId, phone])
  @@unique([storeId, email])
}

model CustomerEmailVerificationToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Order {
  id              String         @id @default(cuid())
  storeId         String
  customerId      String?
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  orderNumber     String         @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String
  city            String?
  notes           String?
  subtotal        Decimal        @db.Decimal(12, 2)
  deliveryCharge  Decimal        @db.Decimal(12, 2)
  couponCode      String?
  discountAmount  Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus  @default(UNPAID)
  deliveryMethod  DeliveryMethod
  status          OrderStatus    @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  productImage String?
  price        Decimal  @db.Decimal(12, 2)
  quantity     Int
  total        Decimal  @db.Decimal(12, 2)
  variant      Json?
}

model Coupon {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code           String
  discountType   DiscountType
  discountValue  Decimal       @db.Decimal(12, 2)
  minOrderAmount Decimal?      @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int           @default(0)
  expiresAt      DateTime?
  status         GenericStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([storeId, code])
}

model ThemeSettings {
  id              String           @id @default(cuid())
  storeId         String           @unique
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  themeName       String
  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String
  surfaceColor    String
  textColor       String
  mutedColor      String
  borderColor     String
  headingFont     String
  bodyFont        String
  layoutStyle     ThemeLayoutStyle @default(CLASSIC_ECOMMERCE)
  customCss       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model MarketingSettings {
  id                  String   @id @default(cuid())
  storeId             String   @unique
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  metaPixelId         String?
  isPixelEnabled      Boolean  @default(false)
  isCapiEnabled       Boolean  @default(false)
  capiAccessToken     String?
  metaDatasetId       String?
  facebookPageUrl     String?
  instagramProfileUrl String?
  whatsappNumber      String?
  messengerLink       String?
  tiktokUrl           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model StoreSettings {
  id                        String   @id @default(cuid())
  storeId                   String   @unique
  store                     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  enableCOD                 Boolean  @default(true)
  enableBkash               Boolean  @default(false)
  enableNagad               Boolean  @default(false)
  enableBankTransfer        Boolean  @default(false)
  minimumOrderAmount        Decimal? @db.Decimal(12, 2)
  insideCityDeliveryCharge  Decimal  @default(0) @db.Decimal(12, 2)
  outsideCityDeliveryCharge Decimal  @default(0) @db.Decimal(12, 2)
  freeDeliveryMinAmount     Decimal? @db.Decimal(12, 2)
  refundPolicy              String?
  privacyPolicy             String?
  termsAndConditions        String?
  homepageSeoTitle          String?
  homepageSeoDescription    String?
  ogImage                   String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model HomepageSettings {
  id                       String   @id @default(cuid())
  storeId                  String   @unique
  store                    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  heroEyebrow              String
  heroTitle                String
  heroSubtitle             String
  heroImage                String
  primaryButtonLabel       String
  primaryButtonHref        String
  secondaryButtonLabel     String
  secondaryButtonHref      String
  categoryEyebrow          String
  categoryTitle            String
  categoryDescription      String
  featuredEyebrow          String
  featuredTitle            String
  featuredDescription      String
  benefitsEyebrow          String
  benefitsTitle            String
  benefitsDescription      String
  promoEyebrow             String
  promoTitle               String
  promoDescription         String
  promoImage               String?
  promoButtonLabel         String
  promoButtonHref          String
  bestSellersEyebrow       String
  bestSellersTitle         String
  bestSellersDescription   String
  testimonialsEyebrow      String
  testimonialsTitle        String
  testimonialsDescription  String
  testimonials             Json     @default("[]")
  newsletterEyebrow        String
  newsletterTitle          String
  newsletterDescription    String
  newsletterButtonLabel    String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Cart {
  id         String     @id @default(cuid())
  storeId    String
  sessionId  String
  customerId String?
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartItems  CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  variant   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignLink {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  source         String
  medium         String
  campaign       String
  content        String?
  destinationUrl String
  generatedUrl   String
  clicks         Int      @default(0)
  orders         Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SubscriptionPlan {
  id            String               @id @default(cuid())
  name          String               @unique
  price         Decimal              @db.Decimal(12, 2)
  interval      SubscriptionInterval
  productLimit  Int?
  features      String[]
  status        GenericStatus        @default(ACTIVE)
  subscriptions StoreSubscription[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model StoreSubscription {
  id                 String             @id @default(cuid())
  storeId            String             @unique
  planId             String
  store              Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}
